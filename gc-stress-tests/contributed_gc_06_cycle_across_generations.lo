// good test case
// GC stress: a doubly linked ring of 20000 nodes (every node is on a cycle) is spliced 1500000 times: each splice allocates a young node and stores it into its two old neighbours, so the cycle's pointers keep crossing generations while replaced nodes die in tenured space; the construction variables are cleared first so nothing keeps the dead history alive; afterwards the ring must close in both directions, every node's next.prev and prev.next must be itself, and the ids must sum to an independently computed value
// main method return value: 0
// gc stress heap: 4194304

class RNode ( int id; RNode next; RNode prev; ) [
    RNode(int i, RNode n, RNode p) { id = i; next = n; prev = p; }
] {
    int get_id() { return id; }
    RNode get_next() { return next; }
    RNode get_prev() { return prev; }
    void set_next(RNode n) { next = n; }
    void set_prev(RNode p) { prev = p; }
}

class Main ( ) {
    int main() {
        RNode first;
        RNode last;
        RNode n;
        RNode c;
        RNode p;
        RNode q;
        RNode start;
        RNode cur;
        int i;
        int sum;
        int bad;
        int steps;
        int fwd;
        int bwd;
        first = new RNode(0, null, null);
        last = first;
        i = 1;
        while ( (i < 20000) ) {
            n = new RNode(i, null, last);
            last.set_next(n);
            last = n;
            i = (i + 1);
        }
        last.set_next(first);
        first.set_prev(last);
        c = first;
        first = null;
        last = null;
        i = 0;
        while ( (i < 1500000) ) {
            p = c.get_prev();
            q = c.get_next();
            n = new RNode((20000 + i), q, p);
            p.set_next(n);
            q.set_prev(n);
            c = q;
            i = (i + 1);
        }
        start = c;
        cur = start;
        sum = 0;
        bad = 0;
        steps = 0;
        while ( (steps < 20000) ) {
            sum = (sum + cur.get_id());
            if ( (! ((cur.get_next()).get_prev() = cur)) ) {
                bad = (bad + 1);
            } else {
                ;
            }
            if ( (! ((cur.get_prev()).get_next() = cur)) ) {
                bad = (bad + 1);
            } else {
                ;
            }
            cur = cur.get_next();
            steps = (steps + 1);
        }
        fwd = 0;
        if ( (cur = start) ) {
            fwd = 1;
        } else {
            ;
        }
        steps = 0;
        while ( (steps < 20000) ) {
            cur = cur.get_prev();
            steps = (steps + 1);
        }
        bwd = 0;
        if ( (cur = start) ) {
            bwd = 1;
        } else {
            ;
        }
        out.print_int(sum);
        out.println();
        out.print_int(bad);
        out.println();
        out.print_int(fwd);
        out.println();
        out.print_int(bwd);
        out.println();
        return 0;
    }
}
